# Copy this file to .env (same folder) and fill in your real key.
# .env is gitignored -- it will never be committed or pushed to GitHub.
# See ADD_API_KEY.md for the full walkthrough.

# Optional: reserved for the future AI Summaries feature. It is not used by
# Helm publishing and does not trigger any automatic AI call.
OPENAI_API_KEY=

# Helm publishing is disabled until both values are set locally.
HELM_STRATEGY_ENDPOINT=
HELM_STRATEGY_API_KEY=
